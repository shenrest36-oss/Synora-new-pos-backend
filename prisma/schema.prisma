// This Prisma schema extends the ella_pms database with POS tables.
// The datasource points at the same MySQL instance as Ella PMS so that
// pos_payments.reservation_id can be a real FK into ella_pms.reservations.

datasource db {
  provider = "mysql"
  url      = env("ELLA_PMS_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// OUTLETS & TABLES
// ---------------------------------------------------------------------------

model PosOutlet {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  location    String?  @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  sections         PosSection[]
  tables           PosTable[]
  orders           PosOrder[]
  printerStations  PosPrinterStation[]

  @@map("pos_outlets")
}

model PosSection {
  id          Int        @id @default(autoincrement())
  outletId    Int        @map("outlet_id")
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(255)

  outlet      PosOutlet  @relation(fields: [outletId], references: [id])
  tables      PosTable[]

  @@map("pos_sections")
}

enum PosTableStatus {
  free
  occupied
  reserved
  cleaning
}

model PosTable {
  id        Int            @id @default(autoincrement())
  outletId  Int            @map("outlet_id")
  sectionId Int?           @map("section_id")
  name      String         @db.VarChar(50)
  seats     Int            @default(4)
  status    PosTableStatus @default(free)
  sortOrder Int            @default(0) @map("sort_order")

  outlet    PosOutlet      @relation(fields: [outletId], references: [id])
  section   PosSection?    @relation(fields: [sectionId], references: [id])
  orders    PosOrder[]

  @@map("pos_tables")
}

// ---------------------------------------------------------------------------
// WAITERS
// ---------------------------------------------------------------------------

model PosWaiter {
  id       Int      @id @default(autoincrement())
  code     String   @db.VarChar(20)
  name     String   @db.VarChar(100)
  isActive Boolean  @default(true) @map("is_active")

  orders   PosOrder[]

  @@map("pos_waiters")
}

// ---------------------------------------------------------------------------
// PRINTER STATIONS  (legacy: m_printer + config_restaurant_printer)
// ---------------------------------------------------------------------------

model PosPrinterStation {
  id          Int       @id @default(autoincrement())
  outletId    Int       @map("outlet_id")
  name        String    @db.VarChar(100)   // e.g. "Kitchen Hot", "Bar"
  printerType Int       @default(0) @map("printer_type")  // 0=KOT, 1=BOT
  isActive    Boolean   @default(true) @map("is_active")

  outlet      PosOutlet @relation(fields: [outletId], references: [id])
  printLogs   PosPrintLog[]

  @@map("pos_printer_stations")
}

// ---------------------------------------------------------------------------
// MENU CATEGORIES  (legacy: major_group → family_group → master_group)
// Single self-referencing tree, level 1/2/3
// ---------------------------------------------------------------------------

model PosMenuCategory {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String   @db.VarChar(100)
  level     Int      @default(1)        // 1=major, 2=family, 3=master
  sortOrder Int      @default(0) @map("sort_order")
  imageUrl  String?  @map("image_url") @db.VarChar(300)
  isActive  Boolean  @default(true) @map("is_active")

  parent    PosMenuCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  PosMenuCategory[] @relation("CategoryTree")
  items     PosMenuItem[]

  @@map("pos_menu_categories")
}

// ---------------------------------------------------------------------------
// MENU ITEMS  (legacy: m_item + m_item_rate)
// ---------------------------------------------------------------------------

model PosMenuItem {
  id             Int             @id @default(autoincrement())
  categoryId     Int             @map("category_id")
  name           String          @db.VarChar(200)
  // Default rate (from m_item.Default_Rate → m_item_rate.Rate_Value)
  defaultRate    Decimal         @map("default_rate") @db.Decimal(10, 2)
  priceType      String          @default("exclusive") @map("price_type") @db.VarChar(16)
  taxClassId     Int?            @map("tax_class_id")
  printerStationId Int?          @map("printer_station_id")
  isSetMenu      Boolean         @default(false) @map("is_set_menu")
  isActive       Boolean         @default(true) @map("is_active")
  imageUrl       String?         @map("image_url") @db.VarChar(300)
  sortOrder      Int             @default(0) @map("sort_order")
  barCode        String?         @map("bar_code") @db.VarChar(20)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamp(0)

  category       PosMenuCategory @relation(fields: [categoryId], references: [id])
  taxClass       PosTaxClass?    @relation(fields: [taxClassId], references: [id])
  orderItems     PosOrderItem[]

  @@map("pos_menu_items")
}

// ---------------------------------------------------------------------------
// TAX  (legacy: tax, tax_class, tax_class_taxes)
// ---------------------------------------------------------------------------

model PosTaxClass {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(100)

  items     PosMenuItem[]
  taxes     PosTaxClassTax[]

  @@map("pos_tax_classes")
}

model PosTax {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(100)
  rate        Float
  description String? @db.VarChar(255)
  isActive    Boolean @default(true) @map("is_active")

  taxClassTaxes PosTaxClassTax[]
  orderItemTaxes PosOrderItemTax[]

  @@map("pos_taxes")
}

model PosTaxClassTax {
  id          Int        @id @default(autoincrement())
  taxClassId  Int        @map("tax_class_id")
  taxId       Int        @map("tax_id")

  taxClass    PosTaxClass @relation(fields: [taxClassId], references: [id])
  tax         PosTax      @relation(fields: [taxId], references: [id])

  @@unique([taxClassId, taxId])
  @@map("pos_tax_class_taxes")
}

// ---------------------------------------------------------------------------
// MEAL PERIODS  (legacy: front_meal_period)
// ---------------------------------------------------------------------------

model PosMealPeriod {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  fromTime  String  @map("from_time") @db.VarChar(8)  // "07:00:00"
  toTime    String  @map("to_time") @db.VarChar(8)
  isActive  Boolean @default(true) @map("is_active")

  orders    PosOrder[]

  @@map("pos_meal_periods")
}

// ---------------------------------------------------------------------------
// VOID REASONS  (legacy: m_void_reason)
// ---------------------------------------------------------------------------

model PosVoidReason {
  id     Int    @id @default(autoincrement())
  reason String @db.VarChar(255)

  itemVoids PosItemVoid[]

  @@map("pos_void_reasons")
}

// ---------------------------------------------------------------------------
// ORDERS  (legacy: front_kot_bot_main)
// ---------------------------------------------------------------------------

enum PosOrderStatus {
  open          // table occupied, items being added
  sent          // KOT/BOT sent to kitchen/bar
  billed        // bill generated, pending payment
  paid          // fully settled
  voided        // cancelled before billing
}

enum PosKitchenStatus {
  new
  preparing
  ready
  served
  cancelled
}

model PosOrder {
  id            Int            @id @default(autoincrement())
  outletId      Int            @map("outlet_id")
  tableId       Int            @map("table_id")
  waiterId      Int?           @map("waiter_id")
  mealPeriodId  Int?           @map("meal_period_id")
  // Optional PMS guest link (room posting use-case)
  // reservationId links into ella_pms.reservations (no Prisma FK across schemas,
  // integrity maintained at application level)
  reservationId Int?           @map("reservation_id")
  guestName     String?        @map("guest_name") @db.VarChar(150)
  roomNumber    String?        @map("room_number") @db.VarChar(10)
  status        PosOrderStatus @default(open)
  kitchenStatus PosKitchenStatus @default(new) @map("kitchen_status")
  startedAt     DateTime?      @map("started_at") @db.Timestamp(0)
  readyAt       DateTime?      @map("ready_at") @db.Timestamp(0)
  servedAt      DateTime?      @map("served_at") @db.Timestamp(0)
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamp(0)
  cancelledReason String?      @map("cancelled_reason") @db.VarChar(255)
  remark        String?        @db.VarChar(255)
  openedAt      DateTime       @default(now()) @map("opened_at") @db.Timestamp(0)
  closedAt      DateTime?      @map("closed_at") @db.Timestamp(0)
  nightDate     DateTime?      @map("night_date") @db.Date
  // Split / merge tracking (mirrors front_kot_bot_main.hasSplit, hasMerge_id)
  hasSplit      Boolean        @default(false) @map("has_split")
  parentOrderId Int?           @map("parent_order_id")
  createdBy     Int            @map("created_by")

  outlet        PosOutlet      @relation(fields: [outletId], references: [id])
  table         PosTable       @relation(fields: [tableId], references: [id])
  waiter        PosWaiter?     @relation(fields: [waiterId], references: [id])
  mealPeriod    PosMealPeriod? @relation(fields: [mealPeriodId], references: [id])
  parentOrder   PosOrder?      @relation("OrderSplits", fields: [parentOrderId], references: [id])
  childOrders   PosOrder[]     @relation("OrderSplits")
  items         PosOrderItem[]
  discounts     PosOrderDiscount[]
  bills         PosBill[]
  printLogs     PosPrintLog[]

  @@index([outletId, status])
  @@index([tableId, status])
  @@map("pos_orders")
}

// ---------------------------------------------------------------------------
// ORDER ITEMS  (legacy: front_kot_bot_item)
// ---------------------------------------------------------------------------

model PosOrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  menuItemId   Int      @map("menu_item_id")
  qty          Decimal  @db.Decimal(8, 2)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  unitPriceWithTax Decimal @map("unit_price_with_tax") @db.Decimal(10, 2)
  comment      String?  @db.VarChar(500)
  taxClassId   Int?     @map("tax_class_id")
  orderedAt    DateTime @default(now()) @map("ordered_at") @db.Timestamp(0)
  sentAt       DateTime? @map("sent_at") @db.Timestamp(0)  // when KOT/BOT was fired

  order        PosOrder     @relation(fields: [orderId], references: [id])
  menuItem     PosMenuItem  @relation(fields: [menuItemId], references: [id])
  taxes        PosOrderItemTax[]
  voids        PosItemVoid[]
  billItems    PosBillItem[]

  @@map("pos_order_items")
}

model PosOrderItemTax {
  id          Int      @id @default(autoincrement())
  orderItemId Int      @map("order_item_id")
  taxId       Int      @map("tax_id")
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(10, 2)

  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id])
  tax         PosTax       @relation(fields: [taxId], references: [id])

  @@map("pos_order_item_taxes")
}

// ---------------------------------------------------------------------------
// ORDER-LEVEL DISCOUNTS  (legacy: front_kot_bot_discount)
// ---------------------------------------------------------------------------

enum PosDiscountValueType {
  percentage
  fixed
}

model PosOrderDiscount {
  id          Int                  @id @default(autoincrement())
  orderId     Int                  @map("order_id")
  orderItemId Int?                 @map("order_item_id")  // null = bill-level discount
  valueType   PosDiscountValueType @default(percentage) @map("value_type")
  value       Decimal              @db.Decimal(10, 2)
  remark      String?              @db.VarChar(100)
  appliedBy   Int                  @map("applied_by")
  appliedAt   DateTime             @default(now()) @map("applied_at") @db.Timestamp(0)

  order       PosOrder  @relation(fields: [orderId], references: [id])

  @@map("pos_order_discounts")
}

// ---------------------------------------------------------------------------
// ITEM VOIDS  (legacy: front_kot_bot_item_void)
// ---------------------------------------------------------------------------

model PosItemVoid {
  id            Int           @id @default(autoincrement())
  orderItemId   Int           @map("order_item_id")
  orderId       Int           @map("order_id")
  voidReasonId  Int?          @map("void_reason_id")
  qty           Int
  voidedBy      Int           @map("voided_by")
  voidedAt      DateTime      @default(now()) @map("voided_at") @db.Timestamp(0)

  orderItem     PosOrderItem  @relation(fields: [orderItemId], references: [id])
  voidReason    PosVoidReason? @relation(fields: [voidReasonId], references: [id])

  @@map("pos_item_voids")
}

// ---------------------------------------------------------------------------
// BILLS  (legacy: front_payment header + front_bill_split)
// ---------------------------------------------------------------------------

enum PosBillStatus {
  open
  paid
  voided
}

model PosBill {
  id          Int           @id @default(autoincrement())
  orderId     Int           @map("order_id")
  billNo      String        @unique @map("bill_no") @db.VarChar(30)
  subtotal    Decimal       @db.Decimal(10, 2)
  taxTotal    Decimal       @map("tax_total") @db.Decimal(10, 2)
  discountTotal Decimal     @map("discount_total") @db.Decimal(10, 2)
  grandTotal  Decimal       @map("grand_total") @db.Decimal(10, 2)
  status      PosBillStatus @default(open)
  splitNo     Int           @default(1) @map("split_no")  // 1 = no split, 2+ = partial
  createdBy   Int           @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  paidAt      DateTime?     @map("paid_at") @db.Timestamp(0)

  order       PosOrder      @relation(fields: [orderId], references: [id])
  items       PosBillItem[]
  taxes       PosBillTax[]
  discounts   PosBillDiscount[]
  payments    PosPayment[]

  @@index([orderId])
  @@map("pos_bills")
}

model PosBillItem {
  id          Int    @id @default(autoincrement())
  billId      Int    @map("bill_id")
  orderItemId Int    @map("order_item_id")
  qty         Decimal @db.Decimal(8, 2)

  bill        PosBill      @relation(fields: [billId], references: [id])
  orderItem   PosOrderItem @relation(fields: [orderItemId], references: [id])

  @@map("pos_bill_items")
}

model PosBillTax {
  id        Int     @id @default(autoincrement())
  billId    Int     @map("bill_id")
  taxId     Int     @map("tax_id")
  taxAmount Decimal @map("tax_amount") @db.Decimal(10, 2)

  bill      PosBill @relation(fields: [billId], references: [id])

  @@map("pos_bill_taxes")
}

model PosBillDiscount {
  id             Int                  @id @default(autoincrement())
  billId         Int                  @map("bill_id")
  valueType      PosDiscountValueType @map("value_type")
  value          Decimal              @db.Decimal(10, 2)
  discountAmount Decimal              @map("discount_amount") @db.Decimal(10, 2)
  remark         String?              @db.VarChar(100)
  appliedBy      Int                  @map("applied_by")
  appliedAt      DateTime             @default(now()) @map("applied_at") @db.Timestamp(0)

  bill           PosBill @relation(fields: [billId], references: [id])

  @@map("pos_bill_discounts")
}

// ---------------------------------------------------------------------------
// PAYMENTS  (legacy: front_payment_details_cash / card / cityledger / room_posting)
// All 4 payment detail tables unified into one polymorphic table
// ---------------------------------------------------------------------------

enum PosPaymentMethod {
  cash
  card
  city_ledger
  room_posting
  complimentary
}

model PosPayment {
  id              Int              @id @default(autoincrement())
  billId          Int              @map("bill_id")
  method          PosPaymentMethod
  amount          Decimal          @db.Decimal(10, 2)
  // --- Cash fields ---
  currencyRate    Float?           @map("currency_rate")
  // --- Card fields ---
  cardNo          String?          @map("card_no") @db.VarChar(30)
  authNo          String?          @map("auth_no") @db.VarChar(30)
  bankName        String?          @map("bank_name") @db.VarChar(50)
  // --- City-ledger fields ---
  cityLedgerAccount String?        @map("city_ledger_account") @db.VarChar(50)
  // --- Room posting fields ---
  // reservationId points into ella_pms.reservations (application-level integrity)
  reservationId   Int?             @map("reservation_id")
  roomNumber      String?          @map("room_number") @db.VarChar(10)
  guestName       String?          @map("guest_name") @db.VarChar(150)
  // Link back to the guest_charges row created in ella_pms
  guestChargeId   Int?             @map("guest_charge_id")
  // ---
  paidAt          DateTime         @default(now()) @map("paid_at") @db.Timestamp(0)
  paidBy          Int              @map("paid_by")
  isVoid          Boolean          @default(false) @map("is_void")

  bill            PosBill          @relation(fields: [billId], references: [id])

  @@index([billId])
  @@index([reservationId])
  @@map("pos_payments")
}

// ---------------------------------------------------------------------------
// KOT/BOT PRINT LOG  (legacy: front_kot_bot_print_no)
// ---------------------------------------------------------------------------

model PosPrintLog {
  id               Int               @id @default(autoincrement())
  orderId          Int               @map("order_id")
  printerStationId Int               @map("printer_station_id")
  printNo          Int               @map("print_no")
  nightDate        DateTime?         @map("night_date") @db.Date
  printedAt        DateTime          @default(now()) @map("printed_at") @db.Timestamp(0)
  printedBy        Int               @map("printed_by")

  order            PosOrder          @relation(fields: [orderId], references: [id])
  printerStation   PosPrinterStation @relation(fields: [printerStationId], references: [id])

  @@map("pos_print_logs")
}

// ---------------------------------------------------------------------------
// OPENING SESSION  (legacy: front_opening + front_opening_balance)
// ---------------------------------------------------------------------------

enum PosSessionStatus {
  open
  closed
}

model PosOpeningSession {
  id          Int              @id @default(autoincrement())
  outletId    Int              @map("outlet_id")
  openedAt    DateTime         @default(now()) @map("opened_at") @db.Timestamp(0)
  closedAt    DateTime?        @map("closed_at") @db.Timestamp(0)
  openingBalance Decimal       @default(0) @map("opening_balance") @db.Decimal(10, 2)
  status      PosSessionStatus @default(open)
  openedBy    Int              @map("opened_by")
  closedBy    Int?             @map("closed_by")

  @@map("pos_opening_sessions")
}

// ---------------------------------------------------------------------------
// TABLE TRANSFER LOG  (legacy: table_transfer)
// ---------------------------------------------------------------------------

model PosTableTransfer {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  fromTableId   Int      @map("from_table_id")
  toTableId     Int      @map("to_table_id")
  transferredBy Int      @map("transferred_by")
  transferredAt DateTime @default(now()) @map("transferred_at") @db.Timestamp(0)

  @@map("pos_table_transfers")
}
